# ========== 后端（Spring Boot / Maven）==========
# 编译产物不进版本库：它们曾经完整，反而掩盖了源码缺文件的问题
springBootTest/target/

# 启动器把后端输出写到这里，日志属于本机运行态数据
springBootTest/log/startup.log
springBootTest/log/backend-8081-ps.log
springBootTest/log/*.log.gz

# 仓库内 uploads 只是旧数据的搬运源，正式文件在 ~/blog-data/uploads
springBootTest/uploads/

# ========== 前端（Vue / Vite）==========
7h/node_modules/
# 构建产物不进版本库：哈希文件名每次打包都变，多人各自构建必然冲突
# start.py 的 ensure_dist() 会在产物缺失时自动 npm run build
7h/dist/
7h/.vite/

# ========== IDE / 系统 ==========
.idea/
*.iml
.vscode/
Thumbs.db
.DS_Store

# 启动脚本自身的字节码缓存
__pycache__/
*.pyc
