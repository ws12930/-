  // 尾迹每帧最多要画上千格，如果每格现拼 "rgba(...)" 字符串，光字符串分配
  // 就是一笔可观开销。把透明度量化成 16 档预先存好，绘制时只做一次下标。
  const TRAIL_STEPS = 16;
  const TRAIL_COLORS = COLORS.map(function (col) {
    const outer = [], inner = [];
    for (let i = 0; i < TRAIL_STEPS; i++) {
      const glow = TRAIL_MIN_GLOW + (1 - TRAIL_MIN_GLOW) * i / (TRAIL_STEPS - 1);
      outer.push(col.soft + (0.05 + 0.16 * glow) + ")");
      inner.push(col.soft + (0.16 + 0.42 * glow) + ")");
    }
    return { outer: outer, inner: inner };
  });

  const SPAWNS = [
