  // ---------- 音效 ----------
  let audioCtx = null;
  function initAudio() {
    if (audioCtx) return;
    try { audioCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch (e) { audioCtx = null; }
  }
  function tone(freq, dur, type, vol, delay) {
    if (!audioCtx) return;
    try {
      const t = audioCtx.currentTime + (delay || 0);
      const o = audioCtx.createOscillator();
      const g = audioCtx.createGain();
      o.type = type || "sine";
      o.frequency.setValueAtTime(freq, t);
      g.gain.setValueAtTime(vol || 0.06, t);
      g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
      o.connect(g);
      g.connect(audioCtx.destination);
      o.start(t);
      o.stop(t + dur);
    } catch (e) { /* 静默 */ }
  }
  function sfxPick(type) {
    if (type === "boost") { tone(660, 0.10, "square", 0.045); tone(990, 0.14, "square", 0.045, 0.09); }
    else if (type === "phase") { tone(520, 0.12, "triangle", 0.055); tone(780, 0.18, "triangle", 0.045, 0.10); }
    else { tone(440, 0.12, "sine", 0.05); tone(660, 0.2, "sine", 0.045, 0.09); }
  }
  function sfxCrash(reason) {
