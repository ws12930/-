<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>光轮 · 双人贪吃蛇</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    background: radial-gradient(1100px 560px at 50% -12%, #ffffff 0%, #eef2f9 58%, #e5ebf5 100%);
    color: #1e293b;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 22px 16px 44px;
  }
  .wrap { width: 100%; max-width: 1200px; }
  header { text-align: center; margin-bottom: 16px; }
  h1 {
    font-size: 30px;
    letter-spacing: 2px;
    font-weight: 800;
    background: linear-gradient(90deg, #0891b2, #7c3aed, #db2777);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .sub { color: #64748b; font-size: 13px; margin-top: 6px; }

  .scoreboard {
    display: grid;
    grid-template-columns: 1fr 66px 1fr;
    gap: 12px;
    align-items: center;
    margin-bottom: 10px;
  }
  .pcard {
    --c: #06b6d4;
    position: relative;
    overflow: hidden;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 14px;
    padding: 11px 16px 12px;
    box-shadow: 0 4px 14px rgba(15, 23, 42, .05);
  }
  .pcard::before {
    content: "";
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    background: var(--c);
  }
  .pcard.p2 { --c: #ec4899; }
  .pname { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px; }
  .pname .dot { width: 9px; height: 9px; border-radius: 3px; background: var(--c); box-shadow: 0 0 8px var(--c); }
  .pname small { margin-left: auto; color: #94a3b8; font-weight: 500; font-size: 12px; }
  .score { font-size: 30px; font-weight: 800; color: var(--c); line-height: 1.15; margin-top: 1px; }
  .pips { display: flex; gap: 5px; margin-top: 5px; }
  .pips i { width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--c); opacity: .3; }
  .pips i.on { background: var(--c); opacity: 1; box-shadow: 0 0 8px var(--c); }
  .buffs { font-size: 12px; color: #64748b; min-height: 18px; margin-top: 5px; letter-spacing: .3px; }
  .vs { text-align: center; color: #94a3b8; font-weight: 800; font-size: 17px; }
  .round-no { font-size: 11px; color: #94a3b8; font-weight: 600; margin-top: 3px; white-space: nowrap; }

  .format-bar {
    display: flex; justify-content: center; align-items: center; gap: 8px;
    margin: 0 0 12px; font-size: 12.5px; color: #64748b; flex-wrap: wrap;
  }
  .flabel { font-weight: 700; color: #94a3b8; }
  .fmt {
    border: 1px solid #cbd5e1; background: #fff; color: #475569;
    padding: 5px 12px; border-radius: 8px; font-size: 12px; font-weight: 700;
    cursor: pointer; transition: .15s;
  }
  .fmt:hover { background: #f1f5f9; transform: translateY(-1px); }
  .fmt.active { background: #0f172a; color: #fff; border-color: #0f172a; }
  .fhint { color: #94a3b8; }

  .arena {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    background: #070b18;
    box-shadow: 0 22px 48px -14px rgba(15, 23, 42, .38), 0 0 0 1px rgba(15, 23, 42, .08);
  }
  canvas { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; }

  /* ===== 主页（开始页）===== */
  .home {
    position: fixed; inset: 0; z-index: 60;
    display: flex; flex-direction: column;
    padding: 30px 22px 40px;
    text-align: center;
    color: #e2e8f0;
    overflow-y: auto;
    background:
      radial-gradient(900px 520px at 50% -8%, rgba(34, 211, 238, .18), rgba(6, 10, 24, 0) 62%),
      radial-gradient(700px 460px at 84% 108%, rgba(236, 72, 153, .15), rgba(6, 10, 24, 0) 60%),
      #060a18;
  }
  .home.hidden { display: none; }
  /* 主页展开时锁住文档滚动：战场比视口高，不锁会多出一条滚动条，
     把全屏主页挤出一道缝 */
  body:has(> .home:not(.hidden)) { overflow: hidden; }
  .home-inner {
    width: 100%; max-width: 940px;
    display: flex; flex-direction: column; align-items: center; gap: 18px;
    margin: auto;
  }
  .home-head { display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .home-kicker {
    font-size: 11px; letter-spacing: .42em; text-indent: .42em;
    color: #7dd3fc;
  }
  .home-title {
    font-size: 62px; line-height: 1.05; font-weight: 800;
    letter-spacing: .18em; text-indent: .18em;
    background: linear-gradient(100deg, #67e8f9, #a78bfa 46%, #f472b6);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 10px 30px rgba(103, 232, 249, .26));
  }
  .home-en { font-size: 11px; letter-spacing: .5em; text-indent: .5em; color: #64748b; }
  .home-tag { font-size: 13px; letter-spacing: .12em; color: #94a3b8; }
  .home-desc { max-width: 64ch; font-size: 13px; line-height: 1.9; color: #a9b6c8; }
  .home-config {
    width: 100%;
    display: flex; flex-direction: column; align-items: center; gap: 12px;
    padding: 18px 16px 20px;
    border: 1px solid rgba(148, 163, 184, .18);
    border-radius: 16px;
    background: rgba(15, 23, 42, .55);
  }
  .home-h2 { font-size: 15px; font-weight: 700; letter-spacing: .2em; text-indent: .2em; color: #e2e8f0; }
  .home-tip { max-width: 78ch; font-size: 12px; line-height: 1.8; color: #8291a6; }
  .home .map-card { width: 208px; background: #0d1526; }
  #btnStart.home-start {
    margin-top: 6px; padding: 12px 46px; font-size: 14px; letter-spacing: .24em;
    text-indent: .24em;
    color: #04121a; border: none; border-radius: 999px;
    background: linear-gradient(120deg, #67e8f9, #7dd3fc 42%, #a78bfa);
    box-shadow: 0 14px 34px -12px rgba(103, 232, 249, .75);
  }
  #btnStart.home-start:hover { filter: brightness(1.07); transform: translateY(-1px); }
  .home-help {
    width: 100%; text-align: left; padding: 0 16px;
    border: 1px solid rgba(148, 163, 184, .16);
    border-radius: 14px;
    background: rgba(15, 23, 42, .45);
  }
  .home-help summary {
    padding: 12px 2px; cursor: pointer;
    font-size: 13px; font-weight: 700; letter-spacing: .12em; color: #cbd5e1;
    list-style: none;
  }
  .home-help summary::-webkit-details-marker { display: none; }
  .home-help summary::before { content: '▸  '; color: #7dd3fc; }
  .home-help[open] summary::before { content: '▾  '; }
  .home-help summary::after { content: '（手感 · 道具 · 规则）'; font-weight: 400; letter-spacing: 0; color: #64748b; }
  .home-help .help { margin: 0 0 14px; }
  .home-help .box {
    background: rgba(2, 6, 23, .6);
    border: 1px solid rgba(148, 163, 184, .16);
    color: #b6c2d4;
  }
  .home-help .box b { color: #e2e8f0; }
  .home-help .tag { background: rgba(148, 163, 184, .18); color: #cbd5e1; }
  .map-cards { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
  .map-card {
    width: 176px; text-align: left; cursor: pointer;
    background: #111a34; border: 1px solid #334155; color: #cbd5e1;
    border-radius: 12px; padding: 13px 15px; transition: .15s;
  }
  .map-card:hover { transform: translateY(-2px); border-color: #64748b; }
  .map-card.active { border-color: #22d3ee; box-shadow: 0 0 0 2px rgba(34,211,238,.25); background: #0d2740; }
  .map-card b { display: block; color: #fff; font-size: 14px; margin-bottom: 6px; }
  .map-card span { font-size: 11.5px; color: #94a3b8; line-height: 1.55; }

  .mode-row { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; align-items: center; }
  .mode-row .flabel { color: #64748b; font-size: 11px; letter-spacing: 1px; }
  .seg {
    display: inline-flex; border: 1px solid #334155; border-radius: 9px;
    overflow: hidden; background: #111a34;
  }
  .seg button {
    border: 0; background: transparent; color: #94a3b8; cursor: pointer;
    padding: 8px 14px; font-size: 12px; font-weight: 700; transition: .15s;
    border-right: 1px solid #334155;
  }
  .seg button:last-child { border-right: 0; }
  .seg button:hover { color: #e2e8f0; background: #16223f; }
  .seg button.active { background: #22d3ee; color: #06202b; }
  .seg.ai button.active { background: #a78bfa; color: #1a0b2e; }
  .seg.disabled { opacity: .35; pointer-events: none; }
  .p2badge { color: #a78bfa !important; }

  .rbtn {
    border: 1px solid #475569; background: #1e293b; color: #e2e8f0;
    border-radius: 8px; padding: 7px 14px; font-size: 12px; font-weight: 700;
    cursor: pointer; transition: .15s;
  }
  .rbtn:hover { background: #334155; }
  .rbtn.active { background: #22d3ee; color: #06202a; border-color: #22d3ee; }
  .rbtn.primary { background: linear-gradient(90deg, #0891b2, #7c3aed); border: 0; padding: 10px 28px; font-size: 14px; }
  .rbtn:disabled { opacity: .4; cursor: not-allowed; }

  .replay-bar {
    position: absolute; left: 0; right: 0; bottom: 0;
    background: rgba(6, 10, 24, .9);
    border-top: 1px solid rgba(148,163,184,.2);
    display: flex; gap: 8px; align-items: center; justify-content: center;
    flex-wrap: wrap; padding: 10px;
  }
  .replay-bar.hidden { display: none; }
  .replay-info { color: #94a3b8; font-size: 12px; font-variant-numeric: tabular-nums; margin-right: 6px; }

  .help { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }
  .box {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 11px 14px;
    font-size: 12.5px;
    color: #475569;
    line-height: 1.8;
  }
  .box b { color: #0f172a; }
  .tag { display: inline-block; padding: 1px 6px; border-radius: 5px; background: #f1f5f9; font-weight: 700; color: #334155; }
  .tag.c1 { background: #ecfeff; color: #0e7490; }
  .tag.c2 { background: #fdf2f8; color: #be185d; }

  .toolbar { display: flex; justify-content: center; gap: 10px; margin-top: 16px; flex-wrap: wrap; }
  button.mainbtn {
    border: 1px solid #cbd5e1;
    background: #fff;
    color: #334155;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    font-size: 13px;
    padding: 9px 20px;
    border-radius: 9px;
    transition: .15s;
  }
  button.mainbtn:hover { background: #f1f5f9; transform: translateY(-1px); }
  button.mainbtn.primary { background: #0f172a; color: #fff; border-color: #0f172a; }
  button.mainbtn.primary:hover { background: #1e293b; }
  button.mainbtn:disabled { opacity: .45; cursor: not-allowed; transform: none; }

  @media (max-width: 620px) {
    .help { grid-template-columns: 1fr; }
    h1 { font-size: 24px; }
    .home { padding: 22px 14px 30px; }
    .home-title { font-size: 40px; }
    .home-config { padding: 14px 12px 16px; }
    #btnStart.home-start { padding: 11px 30px; }
    .score { font-size: 26px; }
    .map-card { width: 100%; }
  }

  /* 窗口不高时（站内 iframe 只有 ~690px）按高度反推宽度，
     让「记分板 + 战场 + 工具栏」整屏可见，不用滚着打 */
  @media (max-height: 820px) {
    body { padding: 8px 14px 10px; }
    .scoreboard { margin-bottom: 6px; }
    .format-bar { margin-bottom: 6px; }
    .toolbar { margin-top: 8px; gap: 8px; }
    .toolbar .mainbtn { padding: 7px 14px; font-size: 12px; }
    .wrap { max-width: calc((100vh - 250px) * 4 / 3); }
  }
</style>
</head>
<body>
<!-- ===== 主页（开始页）：标题 / 简介 / 模式与地图 / 操作说明都收在这一页，
     开局后整页收起，主界面只留战场，不再被说明文字挤占 ===== -->
<div class="home" id="menuPanel">
  <div class="home-inner">
    <header class="home-head">
      <p class="home-kicker">2 PLAYER · LIGHT CYCLE</p>
      <h1 class="home-title">光轮</h1>
      <p class="home-en">LIGHT　CYCLE</p>
      <p class="home-tag">双人同屏 · 对角出生 · 永久轨迹 · 撞线即淘汰</p>
    </header>

    <p class="home-desc">
      光轮是 Tron 里的经典对决：车身后拖着一条永不消失的光轨，撞上任意轨迹、障碍或边界即出局，
      把对手逼进死角就是胜利。同一键盘双人分控，也可以让 AI 陪你练，或干脆看两个 AI 互相算计。
    </p>

    <section class="home-config">
      <h2 class="home-h2">选择对战模式与地图</h2>
      <p class="home-tip">AI 陪练 = 你操控玩家 1 挑战电脑；AI 对决 = 两名 AI 自动互殴，你只管观战。🔥 地狱 = 交替对抗搜索，💀 修罗 = 同时移动对抗搜索，都不给你留情面。</p>
<div class="mode-row">
        <span class="flabel">对手</span>
        <div class="seg" id="modeSeg">
          <button class="active" data-mode="pvp">👥 双人对战</button>
          <button data-mode="pve">🤖 AI 陪练</button>
          <button data-mode="aivai">⚔️ AI 对决</button>
        </div>
      </div>
      <div class="mode-row" id="diffRow">
        <span class="flabel" id="diffLabelP1">玩家 1</span>
        <div class="seg ai" id="diff1Seg">
          <button data-diff="easy">菜鸟</button>
          <button class="active" data-diff="normal">普通</button>
          <button data-diff="hard">高手</button>
          <button data-diff="hell" style="color:#fca5a5">🔥 地狱</button>
          <button data-diff="shura" style="color:#fda4af;font-weight:700">💀 修罗</button>
        </div>
        <span class="flabel" id="diffLabelP2">AI 难度</span>
        <div class="seg ai" id="diffSeg">
          <button data-diff="easy">菜鸟</button>
          <button class="active" data-diff="normal">普通</button>
          <button data-diff="hard">高手</button>
          <button data-diff="hell" style="color:#fca5a5">🔥 地狱</button>
          <button data-diff="shura" style="color:#fda4af;font-weight:700">💀 修罗</button>
        </div>
      </div>
      <div class="map-cards">
        <button class="map-card active" data-map="standard">
          <b>◻ 标准空地图</b>
          <span>纯净场地，只靠走位与道具博弈。适合练手与正面对决。</span>
        </button>
        <button class="map-card" data-map="obstacle">
          <b>▦ 障碍地图</b>
          <span>5 组橙色掩体墙，把场地切成多条通道，卡视野、诱导对手撞墙。</span>
        </button>
        <button class="map-card" data-map="shrink">
          <b>◎ 缩圈地图</b>
          <span>每 30 秒边界向中心收 2 格，逼迫双方不断向内周旋。</span>
        </button>
      </div>
      <button id="btnStart" class="rbtn primary">开始对战</button>
    </section>

    <details class="home-help">
      <summary>操作与规则说明</summary>
  <div class="help">
    <div class="box">
      <b>手感 &amp; 操作</b><br>
      <span class="tag c1">玩家1 · WASD</span> <span class="tag c2">玩家2 · 方向键</span><br>
      <b>120ms 输入缓冲</b>可提前预按；加速有前摇 / 后摇平滑过渡，金色脉冲光晕预警冲刺。<br>
      开局可选「AI 陪练」，玩家 2 交给电脑，五档难度：菜鸟 / 普通 / 高手 / 🔥 地狱 / 💀 修罗。<br>
      地狱级用 α-β 对抗搜索 + 迭代加深，按对手最优应对推演多步，几乎不会自己撞死。<br>
      修罗级把"双方同时移动"直接纳入搜索，每层枚举 3×3 走法组合并判定对撞，判断更贴近真实规则。<br>
      每局结束后自动录制，可用下方「回放上局」逐帧复盘。<b>P</b> 暂停。
    </div>
    <div class="box">
      <b>道具 &amp; 规则</b><br>
      三种道具严格按 <b>⚡疾速 → 🌀瞬转 → 🛡护盾</b> 顺序刷新：疾速 3 秒加速；瞬转穿越一次轨迹；护盾 3 秒内自动抵消 1 次碰撞。<br>
      刷新避开双方与全部轨迹、最多 3 个、14 秒消失。<br>
      撞自己 / 撞对手 / 撞障碍 / 出界 / 缩圈分别提示。
    </div>
  </div>

    </details>
  </div>
</div>

<div class="wrap">

  <div class="scoreboard">
    <div class="pcard p1">
      <div class="pname"><span class="dot"></span><span id="p1Title">玩家 1</span> <small id="p1Keys">W A S D</small></div>
      <div class="score" id="s1">0</div>
      <div class="pips" id="p1pips"></div>
      <div class="buffs" id="b1">—</div>
    </div>
    <div class="vs">
      <div>VS</div>
      <div class="round-no" id="roundNo">第 1 局</div>
    </div>
    <div class="pcard p2">
      <div class="pname"><span class="dot"></span><span id="p2Title">玩家 2</span> <small id="p2Keys">↑ ← ↓ →</small></div>
      <div class="score" id="s2">0</div>
      <div class="pips" id="p2pips"></div>
      <div class="buffs" id="b2">—</div>
    </div>
  </div>

  <div class="format-bar">
    <span class="flabel">赛制</span>
    <button class="fmt active" data-wins="2">3 局 2 胜</button>
    <button class="fmt" data-wins="3">5 局 3 胜</button>
    <span class="fhint" id="fhint">先胜 2 局者获胜</span>
    <span class="flabel" style="margin-left:8px">地图</span>
    <span class="fhint" id="mapHint">标准空地图</span>
  </div>

  <div class="arena">
    <canvas id="game" width="1200" height="900"></canvas>

    <div class="replay-bar hidden" id="replayBar">
      <span class="replay-info" id="replayInfo">回放 0/0</span>
      <button class="rbtn active" data-speed="1">1×</button>
      <button class="rbtn" data-speed="0.5">0.5× 慢放</button>
      <button class="rbtn" id="btnStep">逐帧 ▶</button>
      <button class="rbtn" id="btnExitReplay">退出回放</button>
    </div>
  </div>

  <div class="toolbar">
    <button id="btnPause" class="mainbtn primary">暂停 (P)</button>
    <button id="btnReplay" class="mainbtn" disabled>回放上局</button>
    <button id="btnMenu" class="mainbtn">返回主页</button>
    <button id="btnReset" class="mainbtn">重新开始</button>
  </div>
</div>

<script>
(function () {
  "use strict";

  // ---------- 配置 ----------
  const CELL = 20;
  const COLS = 60;
  const ROWS = 45;
  const W = COLS * CELL;
  const H = ROWS * CELL;
  const TAU = Math.PI * 2;

  const TICK = 10;
  // 输入缓冲放宽到 140ms，并允许缓存两个转向意图：手快连按（上 → 右）时
  // 原来后一个会覆盖前一个，表现为「按了没反应」。
  const INPUT_BUFFER_MS = 140;
  const INPUT_QUEUE_MAX = 2;
  const BOOST_RAMP_IN = 220;
  const BOOST_RAMP_OUT = 320;
  // 移动间隔必须取 TICK 的整数倍。82ms 不是 10 的倍数，实际会走成 80/90ms
  // 交替，视觉上就是一冲一顿；80 / 50 让每一格耗时恒定。
  const BASE_SPEED = 80;
  const BOOST_SPEED = 50;
  const POWERUP_LIFE = 14000;
  const MAX_POWERUPS = 3;
  const SHIELD_MS = 3000;
  const SHRINK_INTERVAL = 30000;
  const SHRINK_STEP = 2;
  const TRAIL_FADE_MS = 7000;
  const TRAIL_MIN_GLOW = 0.24;
  const ROUND_PAUSE = 1500;

  // AI 陪练：菜鸟 / 普通 / 高手 / 地狱 / 修罗，逐档递进
  // 地狱 = 对抗搜索（α-β 剪枝 + 迭代加深），把双方未来若干步都算进去，假设对手完美应对
  //
  // 本轮整体下调一档强度：反应更慢、失误更多、进攻性更低。
  //   react    = 隔多少毫秒才重新决策一次（越大越迟钝）
  //   mistake  = 明知有更优解也走次优方向的概率
  //   searchMs = 搜索型 AI 的同步预算。原来 34 / 70ms 会直接把主线程卡住掉帧，
  //              压到 18 / 30ms，既降难度也换回流畅；maxDepth 同步收紧。
  const AI_CFG = {
    easy:   { react: 340, mistake: 0.42, chase: 0.02, risk: 0.46, voronoi: 0.0, hug: 0.0, name: "菜鸟" },
    normal: { react: 200, mistake: 0.16, chase: 0.18, risk: 0.20, voronoi: 0.45, hug: 0.35, name: "普通" },
    hard:   { react: 95,  mistake: 0.05, chase: 0.55, risk: 0.08, voronoi: 0.80, hug: 0.75, name: "高手" },
    hell:   { react: 40,  mistake: 0.03, chase: 0.00, risk: 0.00, voronoi: 1.0, hug: 0.0, name: "地狱", brain: "search", searchMs: 18, maxDepth: 8 },
    shura:  { react: 22,  mistake: 0.02, chase: 0.00, risk: 0.00, voronoi: 1.0, hug: 0.0, name: "修罗", brain: "pair",   searchMs: 30, maxDepth: 6 }
  };
  const AI_DIRS = [{ x: 0, y: -1 }, { x: 1, y: 0 }, { x: 0, y: 1 }, { x: -1, y: 0 }];

  const POWERUP_CYCLE = ["boost", "phase", "shield"];
  const POWERUP_META = {
    boost: { icon: "⚡", color: "#fbbf24", name: "疾速" },
    phase: { icon: "🌀", color: "#a78bfa", name: "瞬转" },
