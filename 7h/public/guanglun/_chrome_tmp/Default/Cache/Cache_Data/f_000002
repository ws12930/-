  // ---------- 输入缓冲 ----------
  // 转向意图进队列，而不是单槽覆盖：快连按「上 → 右」两下都能生效，
  // 第二下在下一格被消费。AI 自己下发的意图用 replace=true，不和玩家一样排队。
  function setDir(p, nd, replace) {
    if (!p || !p.alive) return;
    const q = p.inputQueue || (p.inputQueue = []);
    if (replace) q.length = 0;
    const last = q.length ? q[q.length - 1] : p.dir;
    if (last.x === nd.x && last.y === nd.y) return;
    if (q.length >= INPUT_QUEUE_MAX) q.shift();
    q.push({ x: nd.x, y: nd.y, at: gameTime });
  }
  function consumeInput(p) {
    let dir = p.dir;
    const q = p.inputQueue;
    if (!q || !q.length) return dir;
    // 一格只消费一条：过期 / 非法掉头的直接丢掉，继续看下一条
    while (q.length) {
      const it = q.shift();
      if (gameTime - it.at > INPUT_BUFFER_MS) continue;
      const reverse = (it.x === -dir.x && it.y === -dir.y);
      if (reverse && p.phaseCharges <= 0) continue;
      dir = { x: it.x, y: it.y };
      break;
    }
    return dir;
  }

  // ---------- AI 陪练引擎 ----------
  // 思路：对每个候选方向做一次"会撞就止步"的洪水填充，估算可活动空间；
  // 空间越大越安全。再叠加顺路道具、贴边惩罚、向对手逼近的进攻分。
  // AI 只通过 setDir 下发意图，走与真人完全一致的缓冲 + 对称裁决通道。

  // 洪水填充：从 (sx,sy) 出发，统计在不撞轨迹/障碍/边界的前提下能到达的格子数。
  // blockA/blockB 视为临时障碍（用于模拟"走完这步后"的局面：自己原头部、对手头部）。
  // 返回 { count, stamp }；stamp 标记本次访问集，用于判断与对手是否仍连通。
  const aiVisited = new Uint32Array(COLS * ROWS);
  // 洪水填充的栈同样预分配：一帧要跑好几次，普通数组 push/pop 的临时对象很浪费
  const aiStack = new Int32Array(COLS * ROWS);
  let aiStamp = 0;

  // Voronoi 领地：从双方头部同时做多源 BFS，每个空格归"先到达"的一方。
  // 轨迹/障碍会挡路，所以它比纯曼哈顿距离更贴近真实的空间争夺——
  // 这是光轮 AI 的核心：即便在开阔区，也能判断往哪走能圈到更多地盘、压缩对手。
  const vorOwner = new Int8Array(COLS * ROWS);
  const vorQueue = new Int32Array(COLS * ROWS);
  function computeVoronoi(myHead, foeHead) {
    vorOwner.fill(0);
    let qh = 0, qt = 0;
    if (myHead >= 0) { vorQueue[qt++] = myHead; vorOwner[myHead] = 1; }
    if (foeHead >= 0) { vorQueue[qt++] = foeHead; vorOwner[foeHead] = -1; }
    while (qh < qt) {
      const c = vorQueue[qh++];
      const x = c % COLS, y = (c - x) / COLS;
      const owner = vorOwner[c];
      for (let d = 0; d < 4; d++) {
        const nx = x + AI_DIRS[d].x, ny = y + AI_DIRS[d].y;
        if (nx < boundary.minX || nx > boundary.maxX || ny < boundary.minY || ny > boundary.maxY) continue;
        const ni = ny * COLS + nx;
        if (vorOwner[ni] !== 0) continue;
        if (grid[ni] !== 0 || obstacleGrid[ni] !== 0) continue;
        vorOwner[ni] = owner;
        vorQueue[qt++] = ni;
      }
    }
    let mine = 0, foe = 0;
    for (let i = 0; i < vorOwner.length; i++) {
      if (vorOwner[i] === 1) mine++;
      else if (vorOwner[i] === -1) foe++;
    }
    return { mine: mine, foe: foe };
  }

  function aiFlood(sx, sy, cap, blockA, blockB) {
    aiStamp++;
    const stamp = aiStamp;
    let sp = 0;
    const start = sy * COLS + sx;
    aiVisited[start] = stamp;
    aiStack[sp++] = start;
    let count = 0;
    while (sp > 0 && count < cap) {
      const c = aiStack[--sp];
      count++;
      const x = c % COLS, y = (c - x) / COLS;
      for (let d = 0; d < 4; d++) {
        const nx = x + AI_DIRS[d].x, ny = y + AI_DIRS[d].y;
        if (nx < boundary.minX || nx > boundary.maxX || ny < boundary.minY || ny > boundary.maxY) continue;
        const ni = ny * COLS + nx;
        if (ni === blockA || ni === blockB) continue;
        if (aiVisited[ni] === stamp) continue;
        if (grid[ni] !== 0 || obstacleGrid[ni] !== 0) continue;
        aiVisited[ni] = stamp;
        aiStack[sp++] = ni;
      }
    }
    return { count: count, stamp: stamp };
  }

  // 单步是否致命（沿用 classify 的判定口径）；phase > 0 可穿轨迹，shield 可兜底一次
  function aiFatal(p, nx, ny, foe) {
    if (nx < boundary.minX || nx > boundary.maxX || ny < boundary.minY || ny > boundary.maxY) {
      return p.shieldCharges > 0 && gameTime < p.shieldUntil ? "soft" : "hard";
    }
    if (obstacleGrid[ny * COLS + nx]) {
      return p.shieldCharges > 0 && gameTime < p.shieldUntil ? "soft" : "hard";
    }
    const cell = grid[ny * COLS + nx];
    if (cell !== 0) {
      if (p.phaseCharges > 0) return "phase";
      return p.shieldCharges > 0 && gameTime < p.shieldUntil ? "soft" : "hard";
    }
    if (foe && foe.alive && foe.x === nx && foe.y === ny) {
      if (p.phaseCharges > 0) return "phase";
      return p.shieldCharges > 0 && gameTime < p.shieldUntil ? "soft" : "hard";
    }
    return null;
  }

  // ---------- 地狱级 AI：对抗搜索 ----------
  // 普通 AI 只看"走这一步之后"的静态局面；地狱 AI 把双方接下来的若干步
  // 都展开成一棵博弈树，用 α-β 剪枝 + 迭代加深搜索，并假设对手每一步都最优。
  // 局面评估 = Voronoi 领地差 + 可达空间 + 出口自由度 + 区域紧凑度。
  const SIM_N = COLS * ROWS;
  const simGrid = new Uint8Array(SIM_N);   // 0 空 / 1 我方轨迹 / 2 对手轨迹 / 3 障碍
  const simVisit = new Uint32Array(SIM_N);
  const simOwner = new Uint8Array(SIM_N);
  const simQueue = new Int32Array(SIM_N);
  let simStamp = 0;
  let searchNodes = 0;
  let searchDeadline = 0;
  let searchAborted = false;

  function dirIndexOf(d) {
    if (d.x === 0) return d.y < 0 ? 0 : 2;
    return d.x > 0 ? 1 : 3;
  }

  function simBuild(p, foe) {
    for (let i = 0; i < SIM_N; i++) {
      const v = grid[i];
      simGrid[i] = obstacleGrid[i] ? 3 : (v === p.id ? 1 : (v === foe.id ? 2 : 0));
    }
  }

  // 多源 BFS：双方头部同时扩张，空格归先到达的一方。
  // 顺带统计"周长"（可达格贴墙/贴轨迹的边数），用于衡量区域是否紧凑。
  function simVoronoi(mx, my, fx, fy, stamp) {
    let qh = 0, qt = 0;
    const m0 = my * COLS + mx;
    simVisit[m0] = stamp; simOwner[m0] = 1; simQueue[qt++] = m0;
    const f0 = fy * COLS + fx;
    if (f0 !== m0) { simVisit[f0] = stamp; simOwner[f0] = 2; simQueue[qt++] = f0; }
    while (qh < qt) {
      const c = simQueue[qh++];
      const x = c % COLS, y = (c - x) / COLS;
      const own = simOwner[c];
      for (let d = 0; d < 4; d++) {
        const nx = x + AI_DIRS[d].x, ny = y + AI_DIRS[d].y;
        if (nx < 0 || nx >= COLS || ny < 0 || ny >= ROWS) continue;
        const ni = ny * COLS + nx;
        if (simVisit[ni] === stamp || simGrid[ni] !== 0) continue;
        simVisit[ni] = stamp; simOwner[ni] = own; simQueue[qt++] = ni;
      }
    }
    let mine = 0, foe = 0, mp = 0, fp = 0;
    for (let k = 0; k < qt; k++) {
      const c = simQueue[k];
      const x = c % COLS, y = (c - x) / COLS;
      const own = simOwner[c];
      let perim = 0;
      for (let d = 0; d < 4; d++) {
        const nx = x + AI_DIRS[d].x, ny = y + AI_DIRS[d].y;
        if (nx < 0 || nx >= COLS || ny < 0 || ny >= ROWS || simGrid[ny * COLS + nx] !== 0) perim++;
      }
      if (own === 1) { mine++; mp += perim; }
      else { foe++; fp += perim; }
    }
    return { mine: mine, foe: foe, mp: mp, fp: fp };
  }

  function simFree(x, y) {
    let n = 0;
    for (let d = 0; d < 4; d++) {
      const nx = x + AI_DIRS[d].x, ny = y + AI_DIRS[d].y;
      if (nx < 0 || nx >= COLS || ny < 0 || ny >= ROWS) continue;
      if (simGrid[ny * COLS + nx] === 0) n++;
    }
    return n;
  }

  // 瞬转只能穿轨迹/对手头部，不能穿边界和固定障碍；返回消耗后的剩余次数，-1 表示不可走
  function simStep(x, y, ph) {
    if (x < 0 || x >= COLS || y < 0 || y >= ROWS) return -1;
    const occ = simGrid[y * COLS + x];
    if (occ === 0) return ph;
    if (occ === 3 || ph <= 0) return -1;
    return ph - 1;
  }

  function spEval(mdi, fdi, mx, my, fx, fy, pPh, fPh, ply) {
    simStamp++;
    const v = simVoronoi(mx, my, fx, fy, simStamp);
    const myFree = simFree(mx, my);
    const foeFree = simFree(fx, fy);
    if (myFree === 0) return -1e7 + ply;
    if (foeFree === 0) return 1e7 - ply;
    // 领地差是决定性指标；紧凑度奖励"贴着墙/轨迹走"，把空间留得更完整
    let s = (v.mine - v.foe) * 3.2;
    s += (v.mine + v.foe) * 0.06;
    s += (myFree - foeFree) * 2.5;
    s += (v.fp / Math.sqrt(v.foe + 1) - v.mp / Math.sqrt(v.mine + 1)) * 3;
    // 瞬转是逃生资源，别无谓浪费
    s += (pPh - fPh) * 2;
    return s;
  }

  // turn: 1=我方走, 2=对手走；交替展开，α-β 剪枝
  function spSearch(turn, mdi, mx, my, fdi, fx, fy, pPh, fPh, depth, alpha, beta, ply) {
    if ((++searchNodes & 63) === 0 && performance.now() > searchDeadline) { searchAborted = true; return 0; }
    if (depth <= 0) return spEval(mdi, fdi, mx, my, fx, fy, pPh, fPh, ply);
    const isMe = turn === 1;
    const cx = isMe ? mx : fx, cy = isMe ? my : fy, cd = isMe ? mdi : fdi;
    const ph = isMe ? pPh : fPh;
    let best = isMe ? -Infinity : Infinity;
    let any = false;
    for (let k = 0; k < 3; k++) {
      const di = k === 0 ? cd : ((k === 1 ? ((cd + 3) & 3) : ((cd + 1) & 3)));
      const nd = AI_DIRS[di];
      const nx = cx + nd.x, ny = cy + nd.y;
      const nextPh = simStep(nx, ny, ph);
      if (nextPh < 0) continue;
      const ci = ny * COLS + nx;
      const oldOcc = simGrid[ci];
      simGrid[ci] = isMe ? 1 : 2;
      any = true;
      const val = isMe
        ? spSearch(2, di, nx, ny, fdi, fx, fy, nextPh, fPh, depth - 1, alpha, beta, ply + 1)
        : spSearch(1, mdi, mx, my, di, nx, ny, pPh, nextPh, depth - 1, alpha, beta, ply + 1);
      simGrid[ci] = oldOcc;
      if (searchAborted) return 0;
      if (isMe) {
        if (val > best) best = val;
        if (best > alpha) alpha = best;
      } else {
        if (val < best) best = val;
        if (best < beta) beta = best;
      }
      if (alpha >= beta) break;
    }
    if (!any) return isMe ? (-1e7 + ply) : (1e7 - ply);
    return best;
  }

  function aiDecideSearch(p, cfg) {
    const foe = players[1 - (p.id - 1)];
    if (!foe || !foe.alive) { aiDecideGreedy(p, cfg); return; }
    simBuild(p, foe);

    const myDi = dirIndexOf(p.dir), foeDi = dirIndexOf(foe.dir);
    const order = [myDi, (myDi + 3) & 3, (myDi + 1) & 3];
    const bonus = [0, 0, 0];
    const early = trailLen(p.id) < 20;

    for (let k = 0; k < 3; k++) {
      const nd = AI_DIRS[order[k]];
      const nx = p.x + nd.x, ny = p.y + nd.y;
      const stepPh = simStep(nx, ny, p.phaseCharges);
      if (stepPh < 0 ||
          (nd.x === -p.dir.x && nd.y === -p.dir.y && p.phaseCharges <= 0)) {
        bonus[k] = -1e9;
        continue;
      }
      let b = 0;
      // 对撞规避：双方同时踩同一格或交换位置会同归于尽，
      // 枚举对手三种可能走法，只要有一撞就重罚，别被对手拉垫背。
      for (let j = 0; j < 3; j++) {
        const fdi = j === 0 ? foeDi : ((foeDi + (j === 1 ? 3 : 1)) & 3);
        const fd = AI_DIRS[fdi];
        const fnx = foe.x + fd.x, fny = foe.y + fd.y;
        if ((fnx === nx && fny === ny) ||
            (fnx === p.x && fny === p.y && nx === foe.x && ny === foe.y)) b -= 150;
      }
      for (let j = 0; j < powerups.length; j++) {
        const u = powerups[j];
        const before = Math.abs(p.x - u.x) + Math.abs(p.y - u.y);
        const after = Math.abs(nx - u.x) + Math.abs(ny - u.y);
        if (after < before) b += u.type === "boost" ? 4 : 8;
        if (after === 0) b += 12;
      }
      // 开局先贴边，把中间的大片空间留给后续切割
      if (early) b -= Math.min(nx, COLS - 1 - nx, ny, ROWS - 1 - ny) * 1.2;
      // 完全同分时轻微随机，避免对称开局走出镜像死循环
      b += Math.random() * 0.8;
      bonus[k] = b;
    }

    searchDeadline = performance.now() + (cfg.searchMs || 24);
    searchNodes = 0;
    let bestDi = -1, bestVal = -Infinity;

    for (let depth = 2; depth <= (cfg.maxDepth || 8); depth++) {
      searchAborted = false;
      let layerDi = -1, layerVal = -Infinity, complete = true;
      for (let k = 0; k < 3; k++) {
        if (bonus[k] <= -1e8) continue;
        const di = order[k], nd = AI_DIRS[di];
        const nx = p.x + nd.x, ny = p.y + nd.y;
        const ci = ny * COLS + nx;
        const oldOcc = simGrid[ci];
        const rootPh = simStep(nx, ny, p.phaseCharges);
        simGrid[ci] = 1;
        const val = spSearch(2, di, nx, ny, foeDi, foe.x, foe.y,
                             rootPh, foe.phaseCharges, depth - 1, -Infinity, Infinity, 1);
        simGrid[ci] = oldOcc;
        if (searchAborted) { complete = false; break; }
        const total = val + bonus[k];
        if (total > layerVal) { layerVal = total; layerDi = di; }
      }
      if (!complete) break;
      if (layerDi >= 0) { bestDi = layerDi; bestVal = layerVal; }
      if (bestVal > 1e6 || performance.now() > searchDeadline) break;
    }

    if (bestDi < 0) { aiDecideGreedy(p, cfg); return; }
    bestDi = applyMistake(p, cfg, bestDi);
    setDir(p, AI_DIRS[bestDi], true);
  }

  // ---------- 修罗级 AI：同时移动对抗搜索 ----------
  // 地狱档把双方走法展开成"我先你后"的交替树，深层无法识别同格对撞。
  // 修罗档每层让双方各走一步，枚举 3×3 组合并按游戏规则直接判定对撞，
  // 用 maximin（我方取最大、对手取最小）+ α-β 剪枝，更贴合真实规则。
  function spPairSearch(mdi, mx, my, fdi, fx, fy, pPh, fPh, depth, alpha, beta, ply) {
    if ((++searchNodes & 31) === 0 && performance.now() > searchDeadline) { searchAborted = true; return 0; }
    if (depth <= 0) return spEval(mdi, fdi, mx, my, fx, fy, pPh, fPh, ply);
    let best = -Infinity;
    for (let a = 0; a < 3; a++) {
      const ndi = a === 0 ? mdi : ((a === 1 ? ((mdi + 3) & 3) : ((mdi + 1) & 3)));
      const nd = AI_DIRS[ndi];
      const nx = mx + nd.x, ny = my + nd.y;
      const myNextPh = simStep(nx, ny, pPh);
      let worst = Infinity;
      for (let b = 0; b < 3; b++) {
        const fdi2 = b === 0 ? fdi : ((b === 1 ? ((fdi + 3) & 3) : ((fdi + 1) & 3)));
        const fd = AI_DIRS[fdi2];
        const fnx = fx + fd.x, fny = fy + fd.y;
        const foeNextPh = simStep(fnx, fny, fPh);
        let val;
        if (myNextPh < 0 && foeNextPh < 0) val = 0;
        else if (myNextPh < 0) val = -1e7 + ply;
        else if (foeNextPh < 0) val = 1e7 - ply;
        else if ((nx === fnx && ny === fny) || (nx === fx && ny === fy && fnx === mx && fny === my)) val = 0;
        else {
          const mi = ny * COLS + nx, fi = fny * COLS + fnx;
          const mOld = simGrid[mi], fOld = simGrid[fi];
          simGrid[mi] = 1; simGrid[fi] = 2;
          val = spPairSearch(ndi, nx, ny, fdi2, fnx, fny, myNextPh, foeNextPh, depth - 1, alpha, beta, ply + 1);
          simGrid[mi] = mOld; simGrid[fi] = fOld;
          if (searchAborted) return 0;
        }
        if (val < worst) worst = val;
        if (worst <= alpha) break;
      }
      if (worst > best) best = worst;
      if (best > alpha) alpha = best;
      if (alpha >= beta) break;
    }
    if (best === -Infinity) return -1e7 + ply;
    return best;
  }

  function aiDecidePair(p, cfg) {
    const foe = players[1 - (p.id - 1)];
    if (!foe || !foe.alive) { aiDecideGreedy(p, cfg); return; }
    simBuild(p, foe);

    const myDi = dirIndexOf(p.dir), foeDi = dirIndexOf(foe.dir);
    const myOrder = [myDi, (myDi + 3) & 3, (myDi + 1) & 3];
    const foeOrder = [foeDi, (foeDi + 3) & 3, (foeDi + 1) & 3];
    const bonus = [0, 0, 0];
    const early = trailLen(p.id) < 20;

    for (let k = 0; k < 3; k++) {
      const nd = AI_DIRS[myOrder[k]];
      const nx = p.x + nd.x, ny = p.y + nd.y;
      const stepPh = simStep(nx, ny, p.phaseCharges);
      if (stepPh < 0 ||
          (nd.x === -p.dir.x && nd.y === -p.dir.y && p.phaseCharges <= 0)) {
        bonus[k] = -1e9;
        continue;
      }
      let b = 0;
      for (let j = 0; j < powerups.length; j++) {
        const u = powerups[j];
        const before = Math.abs(p.x - u.x) + Math.abs(p.y - u.y);
        const after = Math.abs(nx - u.x) + Math.abs(ny - u.y);
        if (after < before) b += u.type === "boost" ? 4 : 8;
        if (after === 0) b += 12;
      }
      if (early) b -= Math.min(nx, COLS - 1 - nx, ny, ROWS - 1 - ny) * 1.2;
      b += Math.random() * 0.8;
      bonus[k] = b;
    }

    // 只有双修罗同场才降预算防卡顿；修罗对地狱等其他组合保持满血
    const foeCfg = AI_CFG[p.id === 1 ? aiDifficulty : aiDifficulty1];
    const bothShura = aiVsAi && foeCfg && foeCfg.brain === "pair";
    searchDeadline = performance.now() + (bothShura ? 40 : (cfg.searchMs || 70));
    searchNodes = 0;
    let bestDi = -1, bestVal = -Infinity;

    for (let rounds = 1; rounds <= (cfg.maxDepth || 6); rounds++) {
      searchAborted = false;
      let layerDi = -1, layerVal = -Infinity, complete = true;
      for (let k = 0; k < 3; k++) {
        if (bonus[k] <= -1e8) continue;
        const ndi = myOrder[k], nd = AI_DIRS[ndi];
        const nx = p.x + nd.x, ny = p.y + nd.y, mi = ny * COLS + nx;
        const myRootPh = simStep(nx, ny, p.phaseCharges);
        let worst = Infinity;
        for (let j = 0; j < 3; j++) {
          const fdi2 = foeOrder[j], fd = AI_DIRS[fdi2];
          const fnx = foe.x + fd.x, fny = foe.y + fd.y;
          const foeRootPh = simStep(fnx, fny, foe.phaseCharges);
          let val;
          if ((fnx === nx && fny === ny) ||
              (fnx === p.x && fny === p.y && nx === foe.x && ny === foe.y)) val = 0;
          else if (foeRootPh < 0) val = 1e7 - 1;
          else {
            const fi = fny * COLS + fnx;
            const mOld = simGrid[mi], fOld = simGrid[fi];
            simGrid[mi] = 1; simGrid[fi] = 2;
            val = spPairSearch(ndi, nx, ny, fdi2, fnx, fny,
                               myRootPh, foeRootPh, rounds - 1, -Infinity, Infinity, 2);
            simGrid[mi] = mOld; simGrid[fi] = fOld;
            if (searchAborted) { complete = false; break; }
          }
          if (val < worst) worst = val;
        }
        if (!complete) break;
        const total = worst + bonus[k];
        if (total > layerVal) { layerVal = total; layerDi = ndi; }
      }
      if (!complete) break;
      if (layerDi >= 0) { bestDi = layerDi; bestVal = layerVal; }
      if (bestVal > 1e6 || performance.now() > searchDeadline) break;
    }

    if (bestDi < 0) { aiDecideGreedy(p, cfg); return; }
    bestDi = applyMistake(p, cfg, bestDi);
    setDir(p, AI_DIRS[bestDi], true);
  }

  // 高难度也留一点破绽：按 mistake 概率在「不会立刻撞死」的方向里随机改道。
  // 搜索型 AI 原本完全不读 mistake，地狱 / 修罗配置里的这一项是死参数。
  function applyMistake(p, cfg, di) {
    if (!cfg.mistake || Math.random() >= cfg.mistake) return di;
    const alts = [];
    for (let k = 0; k < 4; k++) {
      const nd = AI_DIRS[k];
      if (nd.x === -p.dir.x && nd.y === -p.dir.y && p.phaseCharges <= 0) continue;
      if (aiFatal(p, p.x + nd.x, p.y + nd.y, null) === "hard") continue;
      alts.push(k);
    }
    if (alts.length <= 1) return di;
    return alts[Math.floor(Math.random() * alts.length)];
  }

  function aiDecide(p) {
    if (!p || !p.alive || gameState !== "playing") return;
    const cfg = AI_CFG[p.id === 1 ? aiDifficulty1 : aiDifficulty] || AI_CFG.normal;
    // 反应冷却放在唯一入口：搜索型 AI 以前每格都思考，既过强又吃 CPU
    if (gameTime < p.aiNextAt) return;
    p.aiNextAt = gameTime + (cfg.react || 0);
    if (cfg.brain === "search") aiDecideSearch(p, cfg);
    else if (cfg.brain === "pair") aiDecidePair(p, cfg);
    else aiDecideGreedy(p, cfg);
  }

  function aiDecideGreedy(p, cfg) {
    const foe = players[1 - (p.id - 1)];
    const foeAlive = foe && foe.alive;
    const myHead = p.y * COLS + p.x;
    const foeHead = foeAlive ? foe.y * COLS + foe.x : -1;
    const span = Math.max(boundary.maxX - boundary.minX, boundary.maxY - boundary.minY);
    const total = COLS * ROWS;
    const scale = span * 0.4;

    let best = null, bestScore = -Infinity;
    const legal = [];
    for (let d = 0; d < 4; d++) {
      const nd = AI_DIRS[d];
      const reverse = (nd.x === -p.dir.x && nd.y === -p.dir.y);
      // 无瞬转时不能掉头（和 consumeInput 的规则一致）
      if (reverse && p.phaseCharges <= 0) continue;

      const nx = p.x + nd.x, ny = p.y + nd.y;
      const fatal = aiFatal(p, nx, ny, foe);
      if (fatal === "hard") continue;
      legal.push(nd);

      // 落脚点本身是轨迹/障碍时，空间从下一格估算（穿过去之后）
      let seedX = nx, seedY = ny;
      if (fatal === "phase" || fatal === "soft") {
        seedX = nx + nd.x; seedY = ny + nd.y;
        if (seedX < boundary.minX || seedX > boundary.maxX || seedY < boundary.minY || seedY > boundary.maxY) {
          seedX = nx; seedY = ny;
        }
      }
      const seedHead = seedY * COLS + seedX;

      // ① 可达空间：把当前头部当墙，避免把回头路算进来
      const mine = aiFlood(seedX, seedY, total, myHead, -1);
      const reach = mine.count;

      // ② 分离判断：对手头部本身是轨迹，直接查它永远不连通；
      //    改查它的四个邻格——只要有一个落在我可达域内，就仍共享空间。
      let separated = true;
      if (foeAlive) {
        for (let k = 0; k < 4; k++) {
          const ax = foe.x + AI_DIRS[k].x, ay = foe.y + AI_DIRS[k].y;
          if (ax < boundary.minX || ax > boundary.maxX || ay < boundary.minY || ay > boundary.maxY) continue;
          if (aiVisited[ay * COLS + ax] === mine.stamp) { separated = false; break; }
        }
      }

      // ③ 落点出口数：<=1 就是死胡同，钻进去必被围死
      let free = 0;
      for (let k = 0; k < 4; k++) {
        const ax = seedX + AI_DIRS[k].x, ay = seedY + AI_DIRS[k].y;
        if (ax < boundary.minX || ax > boundary.maxX || ay < boundary.minY || ay > boundary.maxY) continue;
        const ai = ay * COLS + ax;
        if (ai === myHead) continue;
        if (grid[ai] === 0 && obstacleGrid[ai] === 0) free++;
      }

      let score;
      if (separated && foeAlive) {
        // 已分家：比拼真实地盘，越大越好且要明显压过对手
        const foeReach = aiFlood(foe.x, foe.y, total, -1, -1).count;
        score = (reach - foeReach) * 2.2 + reach * 0.3;
      } else if (cfg.voronoi > 0 && foeAlive) {
        // 同一片共享区：Voronoi 领地差是核心，可达空间兜底防止把自己困死
        const vor = computeVoronoi(seedHead, foeHead);
        score = (vor.mine - vor.foe) * 1.4 * cfg.voronoi + reach * 0.22;
      } else {
        // 菜鸟：只看可达空间
        score = reach;
      }

      // 贴墙切割：开阔区靠墙/靠轨迹走，把空间切成对自己有利的形状。
      // 有出口富余时才生效，避免沿墙画圈把自己绕死。
      if (cfg.hug > 0 && free >= 2) {
        let hug = 0;
        for (let k = 0; k < 4; k++) {
          const ax = nx + AI_DIRS[k].x, ay = ny + AI_DIRS[k].y;
          if (ax < boundary.minX || ax > boundary.maxX || ay < boundary.minY || ay > boundary.maxY) { hug += 1.4; continue; }
          const ai = ay * COLS + ax;
          if (obstacleGrid[ai]) hug += 1.2;
          else if (grid[ai] === p.id) hug += 0.7;
          else if (grid[ai] !== 0) hug += 0.4;
        }
        score += hug * scale * 0.5 * cfg.hug;
      }

      // 出口越多越好，杜绝钻进轨迹堆把路越走越窄
      score += free * (span * 0.22);

      // 致命但可解：重罚
      if (fatal) score -= total * cfg.risk;
      // 掉头惩罚
      if (reverse) score -= total * 0.25;
      // 死胡同预警
      if (free <= 1) score -= total * 0.45;
      else if (free === 2) score -= total * 0.05;

      // 顺路道具：生存类（护盾/瞬转）权重更高
      for (let k = 0; k < powerups.length; k++) {
        const u = powerups[k];
        const before = Math.abs(p.x - u.x) + Math.abs(p.y - u.y);
        const after = Math.abs(nx - u.x) + Math.abs(ny - u.y);
        const w = u.type === "boost" ? 0.5 : 0.9;
        if (after < before) score += scale * w * (0.3 + cfg.chase);
        if (after === 0) score += scale * w * 2 * (0.3 + cfg.chase);
      }

      // 进攻：共享空间时朝对手逼近争地盘
      if (foeAlive && !separated && cfg.chase > 0.5) {
        const fd = Math.abs(nx - foe.x) + Math.abs(ny - foe.y);
        score += Math.max(0, span * 0.5 - fd) * 0.12 * cfg.chase;
      }

      // 完全同分时轻微随机，避免对称开局走出镜像死循环
      score += Math.random() * 0.5;

      if (score > bestScore) { bestScore = score; best = nd; }
    }

    // 真失误：以概率在「不会立刻撞死」的方向里随便挑一个。
    // 原来的做法只是给某个方向减分，AI 往往还是选回最优解，低难度形同虚设。
    if (best && legal.length > 1 && cfg.mistake > 0 && Math.random() < cfg.mistake) {
      best = legal[Math.floor(Math.random() * legal.length)];
    }

    if (best) {
      p.aiPlan = best;
      setDir(p, best, true);
    }
  }

  window.addEventListener("keydown", function (e) {
    initAudio();
    if (["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", " "].indexOf(e.key) >= 0) e.preventDefault();
    if (gameState === "menu") {
      if (e.key === "Enter") document.getElementById("btnStart").click();
      return;
    }
    if (gameState === "replay") {
      if (e.key === "Escape") exitReplay();
      else if (e.key === " ") { e.preventDefault(); stepReplay(); }
      return;
    }
    if (e.key === "p" || e.key === "P") { togglePause(); return; }
    if (e.key === "r" || e.key === "R") { if (gameState === "gameOver") newMatch(targetWins); return; }
    if (gameState !== "playing") return;

    const k = e.key.toLowerCase();
    if (!aiVsAi) {
      if (k === "w") setDir(players[0], { x: 0, y: -1 });
      else if (k === "a") setDir(players[0], { x: -1, y: 0 });
      else if (k === "s") setDir(players[0], { x: 0, y: 1 });
      else if (k === "d") setDir(players[0], { x: 1, y: 0 });
    }
    if (!vsAI) {
      if (e.key === "ArrowUp") setDir(players[1], { x: 0, y: -1 });
      else if (e.key === "ArrowLeft") setDir(players[1], { x: -1, y: 0 });
      else if (e.key === "ArrowDown") setDir(players[1], { x: 0, y: 1 });
      else if (e.key === "ArrowRight") setDir(players[1], { x: 1, y: 0 });
    }
  });

  function togglePause() {
    if (gameState === "playing") gameState = "paused";
    else if (gameState === "paused") gameState = "playing";
    btnPause.textContent = gameState === "paused" ? "继续 (P)" : "暂停 (P)";
  }
  btnPause.addEventListener("click", togglePause);

  // ---------- 特效 ----------
  function spawnBurst(x, y, color) {
    const cx = x * CELL + CELL / 2;
    const cy = y * CELL + CELL / 2;
    for (let i = 0; i < 26; i++) {
      const a = Math.random() * TAU;
      const sp = 1.5 + Math.random() * 4;
      particles.push({
        x: cx, y: cy,
        vx: Math.cos(a) * sp, vy: Math.sin(a) * sp,
        r: 1.5 + Math.random() * 2.5,
        life: 1, color: color
      });
    }
  }
  function addFloater(text, x, y, color) {
    floaters.push({ text: text, x: x * CELL + CELL / 2, y: y * CELL + CELL / 2, life: 1, color: color });
  }
  function crash(p, reason) {
    p.alive = false;
    roundCrashes[p.id - 1] = reason;
    spawnBurst(p.x, p.y, COLORS[p.id - 1].main);
    addFloater(CRASH_SHORT[reason] || "出局!", p.x, p.y, COLORS[p.id - 1].main);
    sfxCrash(reason);
  }

  // ---------- 道具 ----------
  function applyPowerup(p, u) {
    if (u.type === "boost") {
      p.boostUntil = gameTime + 3000;
      addFloater("⚡ 疾速!", p.x, p.y, "#fbbf24");
    } else if (u.type === "phase") {
      p.phaseCharges = Math.min(p.phaseCharges + 1, 2);
      addFloater("🌀 瞬转!", p.x, p.y, "#a78bfa");
    } else {
      p.shieldUntil = gameTime + SHIELD_MS;
      p.shieldCharges = 1;
      addFloater("🛡 护盾!", p.x, p.y, "#60a5fa");
    }
    sfxPick(u.type);
  }

  function spawnPowerup(collector) {
    const empties = [];
    for (let y = boundary.minY + 1; y < boundary.maxY; y++) {
      for (let x = boundary.minX + 1; x < boundary.maxX; x++) {
        const ci = idx(x, y);
        if (grid[ci] !== 0 || obstacleGrid[ci] !== 0) continue;
        let bad = false;
        for (let i = 0; i < players.length; i++) {
          if (players[i].x === x && players[i].y === y) { bad = true; break; }
        }
        if (bad) continue;
        for (let i = 0; i < powerups.length; i++) {
          if (powerups[i].x === x && powerups[i].y === y) { bad = true; break; }
        }
        if (bad) continue;
        empties.push({ x: x, y: y });
      }
    }
    if (!empties.length) return;
    const c = empties[Math.floor(Math.random() * empties.length)];
    // 严格循环：疾速 → 瞬转 → 护盾 → 疾速 …
    powerupCycleIndex = (powerupCycleIndex + 1) % POWERUP_CYCLE.length;
    const type = POWERUP_CYCLE[powerupCycleIndex];
    powerups.push({ x: c.x, y: c.y, type: type, born: gameTime });
    if (collector) collector.push({ type: type, x: c.x, y: c.y });
  }

  // 轨迹长度直接记在玩家身上：原来每次同时碰撞判定都要扫全图 2700 格，
  // AI 开局判断还得每个决策再扫一次，纯属浪费。
  function trailLen(id) {
    const p = players[id - 1];
    return p ? (p.trailCount || 0) : 0;
  }

  // ---------- 对称判定 ----------
  function classify(i, intents, bothMove) {
    const p = players[i];
    const it = intents[i];
    const nx = it.nx, ny = it.ny;
    if (nx < boundary.minX || nx > boundary.maxX || ny < boundary.minY || ny > boundary.maxY) return { reason: "edge" };
    if (obstacleGrid[idx(nx, ny)]) return { reason: "obstacle" };

    const j = 1 - i;
    if (bothMove) {
      if (intents[j].nx === nx && intents[j].ny === ny) return { reason: "head" };
      if (intents[j].nx === p.x && intents[j].ny === p.y &&
          nx === players[j].x && ny === players[j].y) return { reason: "head" };
    }
    const cell = grid[idx(nx, ny)];
    if (cell !== 0) {
      if (p.phaseCharges > 0) return { reason: null, phase: true };
      return { reason: cell === p.id ? "own" : "enemy" };
    }
    if (players[j].alive && players[j].x === nx && players[j].y === ny) {
      if (p.phaseCharges > 0) return { reason: null, phase: true };
      return { reason: "enemy" };
    }
    return { reason: null };
  }

  function resolveMovers(movers, frame) {
    const intents = [null, null];
    for (let k = 0; k < movers.length; k++) {
      const i = movers[k];
      const dir = consumeInput(players[i]);
      players[i].dir = dir;
      intents[i] = { nx: players[i].x + dir.x, ny: players[i].y + dir.y, dx: dir.x, dy: dir.y };
    }
    const bothMove = (movers.length === 2);

    const results = [null, null];
    for (let k = 0; k < movers.length; k++) {
      const i = movers[k];
      results[i] = classify(i, intents, bothMove);
    }

    // 瞬转（主动）优先于护盾（被动兜底）
    for (let i = 0; i < 2; i++) {
      if (results[i] && results[i].phase) {
        players[i].phaseCharges--;
        spawnBurst(intents[i].nx, intents[i].ny, "#a78bfa");
        addFloater("穿!", intents[i].nx, intents[i].ny, "#a78bfa");
        tone(700, 0.07, "triangle", 0.04);
      }
    }
    // 护盾：3 秒内自动抵消一次碰撞，触发即消失
    for (let k = 0; k < movers.length; k++) {
      const i = movers[k];
      const r = results[i];
      if (!r || !r.reason) continue;
      const p = players[i];
      if (p.shieldCharges > 0 && gameTime < p.shieldUntil) {
        p.shieldCharges = 0;
        p.shieldUntil = 0;
        r.reason = null;
        r.shielded = true;
        spawnBurst(intents[i].nx, intents[i].ny, "#60a5fa");
        addFloater("格挡!", intents[i].nx, intents[i].ny, "#60a5fa");
        tone(520, 0.14, "sine", 0.06);
      }
    }

    if (bothMove && results[0].reason && results[1].reason) {
      const len = [trailLen(1), trailLen(2)];
      if (len[0] === len[1]) {
        roundNote = "同时碰撞 · 轨迹相当，本局平局重赛";
      } else {
        const w = len[0] > len[1] ? 0 : 1;
        results[w].survived = true;
        results[w].reason = null;
        roundNote = "同时碰撞 · 玩家 " + (w + 1) + " 轨迹更长，判定获胜";
        addFloater("判胜", intents[w].nx, intents[w].ny, COLORS[w].main);
      }
    }

    for (let k = 0; k < movers.length; k++) {
      const i = movers[k];
      const p = players[i];
      const r = results[i];
      const ev = {
        i: i, x: p.x, y: p.y,
        dx: intents[i].dx, dy: intents[i].dy,
        reason: r.reason || null,
        shielded: !!r.shielded,
        survived: !!r.survived
      };
      if (r.reason) { crash(p, r.reason); frame.moves.push(ev); continue; }
      if (r.survived) { frame.moves.push(ev); continue; }
      p.x = intents[i].nx;
      p.y = intents[i].ny;
      ev.x = p.x;
      ev.y = p.y;
      const cellIdx = idx(p.x, p.y);
      grid[cellIdx] = p.id;
      trailTime[cellIdx] = gameTime;
      p.trailCount = (p.trailCount || 0) + 1;
      frame.moves.push(ev);

      const pi = powerups.findIndex(function (u) { return u.x === p.x && u.y === p.y; });
      if (pi >= 0) {
        const u = powerups[pi];
        powerups.splice(pi, 1);
        frame.pickups.push({ i: i, type: u.type, x: u.x, y: u.y });
        applyPowerup(p, u);
      }
    }
  }

  function shrinkBoundary(frame) {
    if (activeMapType !== "shrink") return;
    if (gameTime < nextShrinkAt) return;
    nextShrinkAt += SHRINK_INTERVAL;
    if (boundary.maxX - boundary.minX < 11 || boundary.maxY - boundary.minY < 9) return;
    boundary.minX += SHRINK_STEP;
    boundary.maxX -= SHRINK_STEP;
    boundary.minY += SHRINK_STEP;
    boundary.maxY -= SHRINK_STEP;
    frame.boundary = { minX: boundary.minX, maxX: boundary.maxX, minY: boundary.minY, maxY: boundary.maxY };
    powerups = powerups.filter(function (u) {
      return u.x >= boundary.minX && u.x <= boundary.maxX && u.y >= boundary.minY && u.y <= boundary.maxY;
    });
    addFloater("边界收缩!", COLS / 2, ROWS / 2, "#fb7185");
    tone(320, 0.28, "sawtooth", 0.05);
    for (let i = 0; i < 2; i++) {
      const p = players[i];
      if (!p.alive) continue;
      if (p.x < boundary.minX || p.x > boundary.maxX || p.y < boundary.minY || p.y > boundary.maxY) {
        crash(p, "shrink");
        frame.deaths.push({ i: i, x: p.x, y: p.y, reason: "shrink" });
      }
    }
  }

  function doTick() {
    const frame = { t: gameTime, moves: [], pickups: [], spawns: [], deaths: [], boundary: null };

    for (let i = 0; i < 2; i++) {
      const p = players[i];
      if (!p.alive) continue;
      const target = gameTime < p.boostUntil ? 1 : 0;
      const ramp = target > p.speedT ? BOOST_RAMP_IN : BOOST_RAMP_OUT;
      const diff = target - p.speedT;
      if (diff !== 0) p.speedT += Math.min(Math.abs(diff), TICK / ramp) * (diff > 0 ? 1 : -1);
      p.interval = BASE_SPEED + (BOOST_SPEED - BASE_SPEED) * smoothstep(p.speedT);
    }

    powerups = powerups.filter(function (u) { return gameTime - u.born < POWERUP_LIFE; });
    if (gameTime >= nextPowerupAt) {
      if (powerups.length < MAX_POWERUPS) spawnPowerup(frame.spawns);
      nextPowerupAt = gameTime + 5000 + Math.random() * 3000;
    }

    shrinkBoundary(frame);

    const movers = [];
    for (let i = 0; i < 2; i++) {
      const p = players[i];
      if (!p.alive) continue;
      p.acc += TICK;
      if (p.acc >= p.interval) {
        p.acc -= p.interval;
        movers.push(i);
      }
    }
    // AI 在自己移动的这一刻决策，方向立即被 consumeInput 消费，不受缓冲过期影响
    if (aiVsAi && players[0] && players[0].alive && movers.indexOf(0) >= 0) aiDecide(players[0]);
    if (vsAI && players[1] && players[1].alive && movers.indexOf(1) >= 0) aiDecide(players[1]);
    if (movers.length) resolveMovers(movers, frame);
    checkRoundEnd();

    if (currentReplay &&
        (frame.moves.length || frame.pickups.length || frame.spawns.length ||
         frame.deaths.length || frame.boundary)) {
      currentReplay.frames.push(frame);
      // 致命帧可能在本帧才写入，回放按钮需按最新帧数重新判定
      if (gameState === "roundOver") {
        btnReplay.disabled = !(lastReplay && lastReplay.frames.length);
      }
    }
  }

  function checkRoundEnd() {
    if (gameState !== "playing") return;
    const a = players[0], b = players[1];
    if (a.alive && b.alive) return;
    if (!a.alive && !b.alive) roundNote = roundNote || "双方同时出局 · 本局平局重赛";
    else {
      const w = a.alive ? 0 : 1;
      players[w].score++;
      sfxScore();
    }
    gameState = "roundOver";
    roundEndAt = gameTime;
    lastReplay = currentReplay;
    btnReplay.disabled = !lastReplay || !lastReplay.frames.length;
    updateHUD(true, true);
  }

  // ---------- 回放 ----------
  function makeReplayPlayer(id) {
    const sp = SPAWNS[id - 1];
    return {
      id: id, x: sp.x, y: sp.y,
      dir: { x: sp.dir.x, y: sp.dir.y },
      inputQueue: [], alive: true,
      speedT: 0, boostUntil: 0, phaseCharges: 0,
      shieldUntil: 0, shieldCharges: 0
    };
  }

  function buildReplayView(data) {
    const view = {
      mapType: data.mapType,
      grid: new Uint8Array(COLS * ROWS),
      trailTime: new Float32Array(COLS * ROWS),
      obstacleGrid: new Uint8Array(COLS * ROWS),
      boundary: { minX: 0, maxX: COLS - 1, minY: 0, maxY: ROWS - 1 },
      players: [makeReplayPlayer(1), makeReplayPlayer(2)],
      powerups: [],
      // 帧时间戳是全局累加的 gameTime（并非每局从 0 开始），回放时钟必须以首帧为基准，
      // 否则会先空等数秒才出画面；clock 与 time 分离，避免 apply 帧时把播放时钟钉回去。
      time: data.frames.length ? data.frames[0].t : 0,
      clock: data.frames.length ? data.frames[0].t : 0,
      speed: 1,
      frameIndex: 0,
      playing: true,
      data: data
    };
    for (let i = 0; i < data.obstacles.length; i++) {
      const o = data.obstacles[i];
      view.obstacleGrid[idx(o.x, o.y)] = 1;
    }
    for (let i = 0; i < 2; i++) {
      const p = view.players[i];
      const c = idx(p.x, p.y);
      view.grid[c] = p.id;
      view.trailTime[c] = 0;
    }
    return view;
  }

  function applyReplayFrame(frame) {
    const v = replayView;
    if (!v) return;
    v.time = frame.t;

    for (let k = 0; k < frame.spawns.length; k++) {
      const s = frame.spawns[k];
      v.powerups.push({ x: s.x, y: s.y, type: s.type, born: frame.t });
    }
    for (let k = 0; k < frame.pickups.length; k++) {
      const e = frame.pickups[k];
      v.powerups = v.powerups.filter(function (u) { return !(u.x === e.x && u.y === e.y); });
      const p = v.players[e.i];
      if (e.type === "boost") { p.boostUntil = frame.t + 3000; p.speedT = 1; addFloater("⚡ 疾速!", e.x, e.y, "#fbbf24"); }
      else if (e.type === "phase") { p.phaseCharges = Math.min(p.phaseCharges + 1, 2); addFloater("🌀 瞬转!", e.x, e.y, "#a78bfa"); }
      else { p.shieldUntil = frame.t + SHIELD_MS; p.shieldCharges = 1; addFloater("🛡 护盾!", e.x, e.y, "#60a5fa"); }
      sfxPick(e.type);
    }
    for (let k = 0; k < frame.moves.length; k++) {
      const e = frame.moves[k];
      const p = v.players[e.i];
      p.dir = { x: e.dx, y: e.dy };
      p.x = e.x;
      p.y = e.y;
      if (e.shielded) {
        spawnBurst(e.x, e.y, "#60a5fa");
        addFloater("格挡!", e.x, e.y, "#60a5fa");
      }
      if (e.survived) { addFloater("判胜", e.x, e.y, COLORS[e.i].main); continue; }
      if (e.reason) {
        p.alive = false;
        spawnBurst(e.x, e.y, COLORS[e.i].main);
        addFloater(CRASH_SHORT[e.reason] || "出局!", e.x, e.y, COLORS[e.i].main);
        continue;
      }
      const ci = idx(e.x, e.y);
      v.grid[ci] = p.id;
      v.trailTime[ci] = frame.t;
    }
    for (let k = 0; k < frame.deaths.length; k++) {
      const e = frame.deaths[k];
      const p = v.players[e.i];
      p.alive = false;
      spawnBurst(e.x, e.y, COLORS[e.i].main);
      addFloater(CRASH_SHORT[e.reason] || "出局!", e.x, e.y, COLORS[e.i].main);
    }
    if (frame.boundary) v.boundary = frame.boundary;
    updateReplayInfo();
  }

  function startReplay() {
    if (!lastReplay || !lastReplay.frames.length) return;
    initAudio();
    stateBeforeReplay = gameState;
    particles = [];
    floaters = [];
    replayView = buildReplayView(lastReplay);
    gameState = "replay";
    replayBar.classList.remove("hidden");
    for (let i = 0; i < speedBtns.length; i++) {
      speedBtns[i].classList.toggle("active", Number(speedBtns[i].dataset.speed) === replayView.speed);
    }
    updateReplayInfo();
  }

  function stepReplay() {
    if (!replayView) return;
    replayView.playing = false;
    const frames = replayView.data.frames;
    if (replayView.frameIndex >= frames.length) return;
    applyReplayFrame(frames[replayView.frameIndex++]);
  }

  function exitReplay() {
    replayView = null;
    replayBar.classList.add("hidden");
    gameState = stateBeforeReplay;
    // 回放耗时较长，重置结算计时，退出后再给完整的准备时间
    if (gameState === "roundOver") roundEndAt = gameTime;
  }

  function updateReplayInfo() {
    if (!replayView) return;
    replayInfo.textContent = "回放 " + replayView.frameIndex + " / " + replayView.data.frames.length +
      (replayView.playing ? "" : " (暂停)");
  }

  for (let i = 0; i < speedBtns.length; i++) {
    speedBtns[i].addEventListener("click", function () {
      if (!replayView) return;
      replayView.speed = Number(this.dataset.speed);
      replayView.playing = true;
      for (let k = 0; k < speedBtns.length; k++) speedBtns[k].classList.toggle("active", speedBtns[k] === this);
    });
  }
  btnStep.addEventListener("click", stepReplay);
  btnExitReplay.addEventListener("click", exitReplay);
  btnReplay.addEventListener("click", startReplay);

  // ---------- 渲染 ----------
  function rr(x, y, w, h, r) {
    ctx.beginPath();
    if (ctx.roundRect) { ctx.roundRect(x, y, w, h, r); return; }
    ctx.moveTo(x + r, y);
    ctx.arcTo(x + w, y, x + w, y + h, r);
    ctx.arcTo(x + w, y + h, x, y + h, r);
    ctx.arcTo(x, y + h, x, y, r);
    ctx.arcTo(x, y, x + w, y, r);
    ctx.closePath();
  }

  // 背景网格是静态的，每帧重画 100 多条线纯属浪费：预渲染成离屏图，
  // 每帧只 drawImage 一次。扫光条同样预渲染，省掉每帧 createLinearGradient。
  let backdropCache = null;
  let glowBandCache = null;

  function buildBackdropCache() {
    const c = document.createElement("canvas");
    c.width = W; c.height = H;
    const g = c.getContext("2d");
    g.fillStyle = "#070b18";
    g.fillRect(0, 0, W, H);
    g.lineWidth = 1;
    g.strokeStyle = "rgba(86,196,232,0.055)";
    g.beginPath();
    for (let x = 1; x < COLS; x++) { g.moveTo(x * CELL, 0); g.lineTo(x * CELL, H); }
    for (let y = 1; y < ROWS; y++) { g.moveTo(0, y * CELL); g.lineTo(W, y * CELL); }
    g.stroke();
    g.strokeStyle = "rgba(86,196,232,0.095)";
    g.beginPath();
    for (let x = 5; x < COLS; x += 5) { g.moveTo(x * CELL, 0); g.lineTo(x * CELL, H); }
    for (let y = 5; y < ROWS; y += 5) { g.moveTo(0, y * CELL); g.lineTo(W, y * CELL); }
    g.stroke();
    backdropCache = c;

    const band = document.createElement("canvas");
    band.width = W; band.height = 70;
    const bg = band.getContext("2d");
    const sg = bg.createLinearGradient(0, 0, 0, 70);
    sg.addColorStop(0, "rgba(80,220,255,0)");
    sg.addColorStop(0.5, "rgba(80,220,255,0.035)");
    sg.addColorStop(1, "rgba(80,220,255,0)");
    bg.fillStyle = sg;
    bg.fillRect(0, 0, W, 70);
    glowBandCache = band;
  }

  function drawBackdrop() {
    if (!backdropCache) buildBackdropCache();
    ctx.drawImage(backdropCache, 0, 0);

    // 静态网格之上只剩两条动态元素：缓慢下移的扫描细线 + 一条纵向光带
    const off = (gameTime / 45) % 5;
    ctx.fillStyle = "rgba(130,210,255,0.022)";
    for (let y = off - 5; y < H; y += 5) ctx.fillRect(0, y, W, 1);

    const sy = ((gameTime / 14) % (H + 120)) - 60;
    ctx.drawImage(glowBandCache, 0, sy - 35);
  }

  // 障碍每格都带 shadowBlur，在 canvas 上非常贵；障碍是静态的，预渲染一次即可。
  // 回放用的是另一套障碍数据，直接现画（数量少，不影响）。
  let obstacleCache = null;
  let obstacleCacheKey = null;

  function paintObstacles(g, cells) {
    for (let i = 0; i < cells.length; i++) {
      const o = cells[i];
      const px = o.x * CELL, py = o.y * CELL;
      // 橙色实体砖：琥珀外发光 + 金属斜面 + 警示斜纹，和双方轨迹一眼区分
      g.shadowColor = "rgba(251,146,60,0.55)";
      g.shadowBlur = 9;
      g.fillStyle = "rgba(120,53,15,0.62)";
      g.fillRect(px + 1, py + 1, CELL - 2, CELL - 2);
      g.shadowBlur = 0;
      g.fillStyle = "rgba(251,146,60,0.30)";
      g.fillRect(px + 1, py + 1, CELL - 2, 3);
      g.fillRect(px + 1, py + 1, 3, CELL - 2);
      g.strokeStyle = "rgba(251,146,60,0.92)";
      g.lineWidth = 1.2;
      g.strokeRect(px + 1.5, py + 1.5, CELL - 3, CELL - 3);
      g.strokeStyle = "rgba(253,186,116,0.45)";
      g.lineWidth = 1;
      g.beginPath();
      g.moveTo(px + 5, py + CELL - 5); g.lineTo(px + CELL - 5, py + 5);
      g.stroke();
    }
  }

  function drawObstacles() {
    if (gameState === "replay") {
      ctx.save();
      paintObstacles(ctx, obstacleCells);
      ctx.restore();
      return;
    }
    // setupMap 会新建 obstacleCells 数组，引用一变就重建缓存
    if (obstacleCacheKey !== obstacleCells) {
      if (!obstacleCache) {
        obstacleCache = document.createElement("canvas");
        obstacleCache.width = W;
        obstacleCache.height = H;
      }
      const g = obstacleCache.getContext("2d");
      g.clearRect(0, 0, W, H);
      paintObstacles(g, obstacleCells);
      obstacleCacheKey = obstacleCells;
    }
    ctx.drawImage(obstacleCache, 0, 0);
  }

  function drawBoundary() {
    if (activeMapType !== "shrink") return;
    const bx = boundary.minX * CELL;
    const by = boundary.minY * CELL;
    const bw = (boundary.maxX - boundary.minX + 1) * CELL;
    const bh = (boundary.maxY - boundary.minY + 1) * CELL;
    ctx.fillStyle = "rgba(3,6,16,0.7)";
    ctx.fillRect(0, 0, W, by);
    ctx.fillRect(0, by + bh, W, H - by - bh);
    ctx.fillRect(0, by, bx, bh);
    ctx.fillRect(bx + bw, by, W - bx - bw, bh);
    const pulse = 0.45 + 0.25 * Math.abs(Math.sin(gameTime / 400));
    ctx.strokeStyle = "rgba(248,113,113," + pulse + ")";
    ctx.lineWidth = 2;
    ctx.shadowColor = "#fb7185";
    ctx.shadowBlur = 12;
    ctx.strokeRect(bx + 1, by + 1, bw - 2, bh - 2);
    ctx.shadowBlur = 0;
  }

  function drawTrails() {
    for (let y = 0; y < ROWS; y++) {
      for (let x = 0; x < COLS; x++) {
        const ci = idx(x, y);
        const v = grid[ci];
        if (!v) continue;
        const age = gameTime - trailTime[ci];
        const glow = Math.max(TRAIL_MIN_GLOW, 1 - age / TRAIL_FADE_MS);
        // 量化到 16 档查表，避免每格现拼 rgba 字符串（全图上千格时开销很实在）
        const step = ((glow - TRAIL_MIN_GLOW) / (1 - TRAIL_MIN_GLOW) * (TRAIL_STEPS - 1)) | 0;
        const pal = TRAIL_COLORS[v === 1 ? 0 : 1];
        const px = x * CELL, py = y * CELL;
        ctx.fillStyle = pal.outer[step];
        ctx.fillRect(px + 0.5, py + 0.5, CELL - 1, CELL - 1);
        ctx.fillStyle = pal.inner[step];
        ctx.fillRect(px + 3, py + 3, CELL - 6, CELL - 6);
      }
    }
  }

  // 逻辑位置是格子整数，直接按格绘制会 80ms 跳 20px，看起来一顿一顿。
  // 这里用「已到达的格 + 向下一格走的进度」做线性插值，方块在格间平滑滑行。
  function renderPos(p) {
    if (!p.alive) return { x: p.x, y: p.y };
    const interval = p.interval || BASE_SPEED;
    let t = (p.acc || 0) / interval;
    if (t < 0) t = 0; else if (t > 1) t = 1;
    return { x: p.x + p.dir.x * t, y: p.y + p.dir.y * t };
  }

  // 插值后的方块会领先尾迹最多一格，补一段同色连接段，光轨看起来才跟手
  function drawHeadLink(p) {
    const t = Math.min(1, Math.max(0, (p.acc || 0) / (p.interval || BASE_SPEED)));
    if (t <= 0.02) return;
    const col = COLORS[p.id - 1];
    const x0 = p.x * CELL + CELL / 2;
    const y0 = p.y * CELL + CELL / 2;
    const x1 = x0 + p.dir.x * t * CELL;
    const y1 = y0 + p.dir.y * t * CELL;
    ctx.strokeStyle = col.soft + "0.52)";
    ctx.lineWidth = CELL - 6;
    ctx.lineCap = "butt";
    ctx.beginPath();
    ctx.moveTo(x0, y0);
    ctx.lineTo(x1, y1);
    ctx.stroke();
  }

  function drawPlayer(p) {
    const rp = renderPos(p);
    const cx = rp.x * CELL + CELL / 2;
    const cy = rp.y * CELL + CELL / 2;
    const col = COLORS[p.id - 1];
    const spd = p.speedT || 0;
    const boosting = spd > 0.15;
    const shielded = (p.shieldCharges > 0 && gameTime < p.shieldUntil);
    const flicker = boosting ? (0.74 + 0.26 * Math.abs(Math.sin(gameTime / 55))) : 1;

    const haloR = 13 + spd * 13;
    const haloRGB = boostedRGB(boosting, shielded, col);
    const grad = ctx.createRadialGradient(cx, cy, 1, cx, cy, haloR);
    grad.addColorStop(0, "rgba(" + haloRGB + "," + (0.46 * flicker) + ")");
    grad.addColorStop(0.45, "rgba(" + haloRGB + "," + (0.16 * flicker) + ")");
    grad.addColorStop(1, "rgba(" + haloRGB + ",0)");
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.arc(cx, cy, haloR, 0, TAU);
    ctx.fill();

    if (boosting) {
      ctx.strokeStyle = "rgba(251,191,36," + (0.34 * flicker) + ")";
      ctx.lineWidth = 2;
      const bx = -p.dir.x, by = -p.dir.y;
      const sx = -by, sy = bx;
      for (let s = -1; s <= 1; s += 2) {
        const ox = sx * s * 6, oy = sy * s * 6;
        ctx.beginPath();
        ctx.moveTo(cx + ox + bx * 9, cy + oy + by * 9);
        ctx.lineTo(cx + ox + bx * (16 + spd * 6), cy + oy + by * (16 + spd * 6));
        ctx.stroke();
      }
    }

    ctx.save();
    ctx.shadowColor = boostedColor(boosting, shielded, col);
    ctx.shadowBlur = 14 + spd * 12;
    ctx.fillStyle = col.main;
    rr(cx - 8, cy - 8, 16, 16, 5);
    ctx.fill();
    ctx.restore();

    ctx.fillStyle = (p.inputQueue && p.inputQueue.length) ? "#ffffff" : "#070b18";
    ctx.beginPath();
    ctx.arc(cx + p.dir.x * 3.2, cy + p.dir.y * 3.2, 2.6, 0, TAU);
    ctx.fill();

    if (p.phaseCharges > 0) {
      ctx.strokeStyle = "rgba(167,139,250,0.95)";
      ctx.lineWidth = 2;
      for (let k = 0; k < p.phaseCharges; k++) {
        const a0 = gameTime / 300 + k * 2.2;
        ctx.beginPath();
        ctx.arc(cx, cy, 15, a0, a0 + 1.3);
        ctx.stroke();
      }
    }

    if (shielded) {
      ctx.strokeStyle = "rgba(96,165,250," + (0.65 + 0.3 * Math.abs(Math.sin(gameTime / 90))) + ")";
      ctx.lineWidth = 2;
      ctx.beginPath();
      for (let k = 0; k < 6; k++) {
        const a = gameTime / 500 + k * TAU / 6;
        const px = cx + Math.cos(a) * 18;
        const py = cy + Math.sin(a) * 18;
        if (k === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.stroke();
    }
  }

  function boostedRGB(boosting, shielded, col) {
    if (boosting) return "251,191,36";
    if (shielded) return "96,165,250";
    return col.rgb;
  }
  function boostedColor(boosting, shielded, col) {
    if (boosting) return "#fbbf24";
    if (shielded) return "#60a5fa";
    return col.main;
  }

  function drawPowerup(u) {
    const cx = u.x * CELL + CELL / 2;
    const cy = u.y * CELL + CELL / 2;
    const meta = POWERUP_META[u.type];
    const col = meta.color;
    const pulse = 1 + Math.sin(gameTime / 180 + u.x) * 0.12;
    const left = POWERUP_LIFE - (gameTime - u.born);
    ctx.save();
    ctx.shadowColor = col;
    ctx.shadowBlur = 16;
    ctx.fillStyle = "rgba(7,11,24,0.9)";
    ctx.beginPath();
    ctx.arc(cx, cy, 9 * pulse, 0, TAU);
    ctx.fill();
    ctx.strokeStyle = col;
    ctx.lineWidth = 2;
    ctx.stroke();
    ctx.shadowBlur = 0;
    ctx.fillStyle = col;
    ctx.font = "bold 12px sans-serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(meta.icon, cx, cy + 1);
    if (left < 3500) {
      ctx.strokeStyle = "rgba(248,113,113,0.9)";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(cx, cy, 13, -Math.PI / 2, -Math.PI / 2 + TAU * Math.max(0, left / 3500));
      ctx.stroke();
    }
    ctx.restore();
  }

  function drawOverlay() {
    if (gameState === "playing" || gameState === "replay" || gameState === "menu") return;
    ctx.fillStyle = gameState === "paused" ? "rgba(6,10,24,0.62)" : "rgba(6,10,24,0.78)";
    ctx.fillRect(0, 0, W, H);
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    if (gameState === "paused") {
      ctx.fillStyle = "#e2e8f0";
      ctx.font = "bold 30px sans-serif";
      ctx.fillText("已暂停 · 按 P 继续", W / 2, H / 2);
      return;
    }

    if (gameState === "roundOver") {
      let y = H / 2 - 74;
      for (let i = 0; i < 2; i++) {
        if (!roundCrashes[i]) continue;
        ctx.fillStyle = COLORS[i].main;
        ctx.font = "bold 18px sans-serif";
        ctx.fillText("玩家 " + (i + 1) + " · " + CRASH_TEXT[roundCrashes[i]], W / 2, y);
        y += 27;
      }
      if (roundNote) {
        ctx.fillStyle = "#cbd5e1";
        ctx.font = "14px sans-serif";
        ctx.fillText(roundNote, W / 2, y + 2);
      }
      const hasWinner = players[0].alive || players[1].alive;
      ctx.font = "bold 34px sans-serif";
      if (!hasWinner) {
        ctx.fillStyle = "#e2e8f0";
        ctx.fillText("势均力敌 · 本局平局重赛", W / 2, H / 2 + 34);
      } else {
        const w = players[0].alive ? 0 : 1;
        const col = COLORS[w].main;
        ctx.fillStyle = col;
        ctx.shadowColor = col;
        ctx.shadowBlur = 18;
        ctx.fillText("玩家 " + (w + 1) + " 得分！", W / 2, H / 2 + 34);
        ctx.shadowBlur = 0;
      }
      ctx.fillStyle = "#94a3b8";
      ctx.font = "15px sans-serif";
      ctx.fillText("当前比分 " + players[0].score + " : " + players[1].score + " · 下一局准备中…", W / 2, H / 2 + 78);
      return;
    }

    if (gameState === "gameOver") {
      const winner = players[0].score > players[1].score ? 0 : 1;
      const col = COLORS[winner].main;
      ctx.fillStyle = "#94a3b8";
      ctx.font = "16px sans-serif";
      ctx.fillText("最终比分 " + players[0].score + " : " + players[1].score, W / 2, H / 2 - 58);
      ctx.fillStyle = col;
      ctx.shadowColor = col;
      ctx.shadowBlur = 22;
      ctx.font = "bold 42px sans-serif";
      ctx.fillText("🏆 玩家 " + (winner + 1) + " 获胜！", W / 2, H / 2);
      ctx.shadowBlur = 0;
      ctx.fillStyle = "#cbd5e1";
      ctx.font = "16px sans-serif";
      ctx.fillText("按 R 或点击「重新开始」再来一场", W / 2, H / 2 + 48);
    }
  }

  function drawScene() {
    drawBackdrop();
    drawObstacles();
    drawBoundary();
    drawTrails();
    // 方块是插值绘制的，领先尾迹最多一格，补上连接段让光轨连成一体
    for (let i = 0; i < players.length; i++) if (players[i].alive) drawHeadLink(players[i]);
    for (let i = 0; i < powerups.length; i++) drawPowerup(powerups[i]);
    for (let i = 0; i < players.length; i++) if (players[i].alive) drawPlayer(players[i]);

    for (let i = 0; i < particles.length; i++) {
      const pt = particles[i];
      ctx.globalAlpha = Math.max(0, pt.life);
      ctx.fillStyle = pt.color;
      ctx.beginPath();
      ctx.arc(pt.x, pt.y, pt.r, 0, TAU);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
    for (let i = 0; i < floaters.length; i++) {
      const f = floaters[i];
      ctx.globalAlpha = Math.max(0, f.life);
      ctx.fillStyle = f.color;
      ctx.font = "bold 15px sans-serif";
      ctx.textAlign = "center";
      ctx.fillText(f.text, f.x, f.y - (1 - f.life) * 34);
    }
    ctx.globalAlpha = 1;
    drawOverlay();
  }

  // 回放渲染：临时把全局视图切到回放快照，画完再还原
  function render() {
    if (gameState !== "replay" || !replayView) { drawScene(); return; }
    const v = replayView;
    const backup = {
      grid: grid, trailTime: trailTime, obstacleGrid: obstacleGrid,
      obstacleCells: obstacleCells, boundary: boundary, activeMapType: activeMapType,
      players: players, powerups: powerups, gameTime: gameTime,
      roundCrashes: roundCrashes, roundNote: roundNote
    };
    grid = v.grid;
    trailTime = v.trailTime;
    obstacleGrid = v.obstacleGrid;
    obstacleCells = v.data.obstacles;
    boundary = v.boundary;
    activeMapType = v.mapType;
    players = v.players;
    powerups = v.powerups;
    gameTime = v.time;
    roundCrashes = [null, null];
    roundNote = "";

    drawScene();
    ctx.fillStyle = "rgba(34,211,238,0.9)";
    ctx.font = "bold 13px sans-serif";
    ctx.textAlign = "left";
    ctx.textBaseline = "top";
    ctx.fillText("● 回放中 · " + MAP_NAMES[v.mapType], 12, 12);

    grid = backup.grid;
    trailTime = backup.trailTime;
    obstacleGrid = backup.obstacleGrid;
    obstacleCells = backup.obstacleCells;
    boundary = backup.boundary;
    activeMapType = backup.activeMapType;
    players = backup.players;
    powerups = backup.powerups;
    gameTime = backup.gameTime;
    roundCrashes = backup.roundCrashes;
    roundNote = backup.roundNote;
  }

  function updateHUD(force, forcePips) {
    for (let i = 0; i < 2; i++) {
      const p = players[i];
      if (!p) continue;
      sEl[i].textContent = p.score;
      if (forcePips) {
        let html = "";
        for (let k = 0; k < targetWins; k++) html += "<i class='" + (k < p.score ? "on" : "") + "'></i>";
        pipEl[i].innerHTML = html;
      }
      const parts = [];
      const rem = Math.max(0, (p.boostUntil - gameTime) / 1000);
      if (rem > 0) parts.push("⚡ " + rem.toFixed(1) + "s");
      if (p.phaseCharges > 0) parts.push("🌀 ×" + p.phaseCharges);
      if (p.shieldCharges > 0 && gameTime < p.shieldUntil) {
        parts.push("🛡 " + Math.max(0, (p.shieldUntil - gameTime) / 1000).toFixed(1) + "s");
      }
      const str = parts.join("   ") || "—";
      if (force || str !== hudCache[i]) { bEl[i].textContent = str; hudCache[i] = str; }
    }
    roundNoEl.textContent = "第 " + roundIndex + " 局";
  }

  // ---------- 主循环 ----------
  function loop(now) {
    requestAnimationFrame(loop);
    if (!lastFrame) lastFrame = now;
    let dt = now - lastFrame;
    lastFrame = now;
    if (dt > 100) dt = 100;

    if (gameState === "playing") {
      tickAcc += dt;
      // 卡顿后不要把欠下的时间无限积压，否则下一次会连着快进一大段
      if (tickAcc > TICK * 20) tickAcc = TICK * 20;
      let guard = 0;
      while (tickAcc >= TICK && guard < 20 && gameState === "playing") {
        tickAcc -= TICK;
        gameTime += TICK;
        doTick();
        guard++;
      }
      updateHUD(false, false);
    } else if (gameState === "roundOver") {
      gameTime += dt;
      if (gameTime - roundEndAt > ROUND_PAUSE) {
        if (players[0].score >= targetWins || players[1].score >= targetWins) {
          gameState = "gameOver";
          sfxWin();
        } else {
          roundIndex++;
          resetRound();
        }
      }
    } else if (gameState === "replay" && replayView) {
      const frames = replayView.data.frames;
      if (replayView.playing) {
        replayView.clock += dt * replayView.speed;
        let guard = 0;
        while (replayView.frameIndex < frames.length &&
               frames[replayView.frameIndex].t <= replayView.clock && guard < 200) {
          applyReplayFrame(frames[replayView.frameIndex++]);
          guard++;
        }
        if (replayView.frameIndex >= frames.length) {
          replayView.playing = false;
          replayInfo.textContent = "回放结束 · " + frames.length + " / " + frames.length;
        } else {
          updateReplayInfo();
        }
      }
    }

    for (let i = particles.length - 1; i >= 0; i--) {
      const pt = particles[i];
      pt.x += pt.vx * dt / 16;
      pt.y += pt.vy * dt / 16;
      pt.vx *= 0.96;
      pt.vy *= 0.96;
      pt.life -= dt / 700;
      if (pt.life <= 0) particles.splice(i, 1);
    }
    for (let i = floaters.length - 1; i >= 0; i--) {
      floaters[i].life -= dt / 900;
      if (floaters[i].life <= 0) floaters.splice(i, 1);
    }

    render();
  }

  // 初始化：显示菜单，先准备一局用于背景渲染
  newMatch(2);
  updateDiffUI();
  gameState = "menu";
  menuPanel.classList.remove("hidden");
  requestAnimationFrame(loop);
})();
</script>

<script>
(function () {
  window.__err = [];
  window.addEventListener("error", function (e) { window.__err.push(String(e.message)); });
  window.addEventListener("unhandledrejection", function (e) { window.__err.push("rej:" + e.reason); });

  var params = new URLSearchParams(location.search);
  if (params.has("autotest")) {
    setTimeout(function () {
      var mode = params.get("mode") || "pve";
      var diff = params.get("diff") || "normal";
      var m = document.querySelector('#modeSeg button[data-mode="' + mode + '"]');
      if (m) m.click();
      var d = document.querySelector('#diffSeg button[data-diff="' + diff + '"]');
      if (d) d.click();
      var s = document.getElementById("btnStart");
      if (s) s.click();
    }, 120);
  }

  setTimeout(function () {
    var out = document.createElement("div");
    out.id = "__probe";
    var rn = document.getElementById("roundNo");
    var s1 = document.getElementById("s1");
    var s2 = document.getElementById("s2");
    var b1 = document.getElementById("b1");
    out.setAttribute("data-err", (window.__err.join(" | ") || "none"));
    out.setAttribute("data-round", rn ? rn.textContent : "?");
    out.setAttribute("data-score", (s1 ? s1.textContent : "?") + "-" + (s2 ? s2.textContent : "?"));
    out.setAttribute("data-buffs", b1 ? b1.textContent : "?");
    out.textContent = "probe";
    document.body.appendChild(out);
  }, 5000);
})();
</script>
</body>
